{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".next/**",
        "out/**",
        "worker/generated/**",
        "lib/generated/**",
        "!.next/cache/**"
      ]
    },
    "generate": {
      "outputs": ["src/generated/**"],
      "inputs": ["$TURBO_DEFAULT$", "scripts/**"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "check": {
      "dependsOn": ["^build", "build", "@nanisoft/site#build"]
    },
    "lint": {}
  }
}
