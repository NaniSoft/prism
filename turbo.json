{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "out/**", "!.next/cache/**"]
    },
    "generate": {
      "outputs": ["src/generated/**"],
      "inputs": ["$TURBO_DEFAULT$", "scripts/**"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "check": {
      "dependsOn": ["^build", "build"]
    },
    "lint": {}
  }
}
