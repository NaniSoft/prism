{
  "name": "prism",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check": "node scripts/check-dashes.mjs && node scripts/check-elevation-layout.mjs && turbo run check",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "node scripts/clean.mjs",
    "check:copy": "node scripts/check-dashes.mjs",
    "changeset": "changeset",
    "changeset:validate": "node scripts/validate-changesets.mjs",
    "changeset:version": "changeset version",
    "release": "changeset publish",
    "release:pre:enter": "changeset pre enter next",
    "release:pre:exit": "changeset pre exit",
    "release:dry": "node scripts/verify-tarballs.mjs --mode=verify && pnpm -r --filter \"./packages/*\" publish --dry-run --no-git-checks",
    "release:verify": "node scripts/verify-tarballs.mjs"
  },
  "devDependencies": {
    "@changesets/assemble-release-plan": "^7.0.0",
    "@changesets/cli": "^3.0.3",
    "@changesets/read": "^1.0.1",
    "publint": "^0.3.24",
    "turbo": "^2.11.4",
    "typescript": "^5.7.0"
  }
}
