node_modules/
dist/
.next/
out/
.turbo/
*.tsbuildinfo
.source/

.env
.env.local
.env.*.local

.DS_Store
Thumbs.db

.vercel/
*.log
npm-debug.log*
pnpm-debug.log*

# local agent/tool state, never committed
.claude/
.impeccable/
.opencode/
.playwright-mcp/
.superpowers/
opencode.exe

packages/tokens/.generated/

# Derived from the registry source on every predev/prebuild/pretypecheck, so it is
# never edited by hand and never committed stale. See apps/docs/scripts/analyze-blocks.mjs
apps/site/src/generated/

# The MCP lane's build stamp: generated before the package build and derived from
# the corpus source commit date plus the corpus version. Kept out of the corpus
# dist so build-twice determinism never sees it.
packages/mcp-server/src/generated/

# Staged into each package by scripts/stage-package-files.mjs at pack time so a
# published tarball carries LICENSE and THIRD-PARTY-NOTICES.md.
packages/*/LICENSE
packages/*/THIRD-PARTY-NOTICES.md

# The project-local pnpm store (see .npmrc).
.pnpm-store/
