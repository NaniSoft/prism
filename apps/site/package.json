{
  "name": "@nanisoft/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @nanisoft/prism-tokens build && pnpm --filter @nanisoft/prism-ui build && node ../../scripts/dev-cache-guard.mjs && node scripts/analyze-blocks.mjs",
    "dev": "next dev --turbopack",
    "prebuild": "pnpm --filter @nanisoft/prism-tokens build && node scripts/analyze-blocks.mjs",
    "build": "next build",
    "start": "next start",
    "catalog:analyze": "node scripts/analyze-blocks.mjs",
    "pretypecheck": "node scripts/analyze-blocks.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@nanisoft/prism-ui": "workspace:*",
    "@nanisoft/prism-tokens": "workspace:*",
    "lucide-react": "^0.545.0",
    "next": "^16.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.7.0"
  }
}
