# Cloudflare Static Assets headers (ticket 03).
# Next copies public/_headers → out/_headers on static export.

# Content-hashed Next chunks — immutable forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# prism-llms artifacts regenerate per deploy (deploy is invalidation).
/llms.txt
  Cache-Control: public, max-age=300
/llms-full.txt
  Cache-Control: public, max-age=300
/md/*
  Cache-Control: public, max-age=300

# The RSS feed is baked per deploy.
/rss.xml
  Cache-Control: public, max-age=3600
