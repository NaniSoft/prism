{
  "surface": {
    "ground": {
      "$type": "color",
      "$value": "{color.ground.light}",
      "$description": "Page ground (→ antd colorBgLayout, light only).",
      "$extensions": {
        "prism.antd": {
          "map": "colorBgLayout"
        }
      }
    },
    "container": {
      "$type": "color",
      "$value": "{color.surface.light}",
      "$description": "Container surface (→ antd colorBgBase seed).",
      "$extensions": {
        "prism.antd": {
          "seed": "colorBgBase"
        }
      }
    },
    "scrim": {
      "$type": "color",
      "$value": "rgba(15, 23, 42, 0.32)",
      "$description": "Scrim over page content (→ antd colorBgMask).",
      "$extensions": {
        "prism.antd": {
          "map": "colorBgMask"
        }
      }
    }
  },
  "text": {
    "primary": {
      "$type": "color",
      "$value": "{color.text.light}",
      "$description": "Body text base (→ antd colorTextBase seed).",
      "$extensions": {
        "prism.antd": {
          "seed": "colorTextBase"
        }
      }
    },
    "secondary": {
      "$type": "color",
      "$value": "rgba(26, 42, 74, 0.68)",
      "$description": "Secondary text — derived, no override."
    },
    "tertiary": {
      "$type": "color",
      "$value": "rgba(26, 42, 74, 0.45)",
      "$description": "Tertiary text — derived, no override."
    },
    "faint": {
      "$type": "color",
      "$value": "rgba(26, 42, 74, 0.3)",
      "$description": "Faint text — derived, no override."
    },
    "onInk": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$description": "Text on ink surfaces (→ antd colorTextLightSolid)."
    }
  },
  "ink": {
    "primary": {
      "$type": "color",
      "$value": "{color.ink.light}",
      "$description": "The accent (→ antd colorPrimary + colorLink seeds).",
      "$extensions": {
        "prism.antd": {
          "seed": [
            "colorPrimary",
            "colorLink"
          ]
        }
      }
    }
  },
  "hairline": {
    "strong": {
      "$type": "color",
      "$value": "{color.hairline.light}",
      "$description": "Hairline.strong (→ antd colorBorder).",
      "$extensions": {
        "prism.antd": {
          "map": "colorBorder"
        }
      }
    },
    "faint": {
      "$type": "color",
      "$value": "rgba(37, 99, 235, 0.06)",
      "$description": "Hairline.faint (→ antd colorBorderSecondary + colorSplit).",
      "$extensions": {
        "prism.antd": {
          "map": [
            "colorBorderSecondary",
            "colorSplit"
          ]
        }
      }
    }
  },
  "accent": {
    "live": {
      "$type": "color",
      "$value": "{color.ink.light}",
      "$description": "Live-state flood — selection/active/pressed; one accent owns them (ADR-0001 §7).",
      "$extensions": {
        "prism.antd": {
          "map": [
            "controlItemBgActive",
            "controlItemBgActiveHover",
            "colorBgTextActive",
            "colorPrimaryTextActive"
          ]
        }
      }
    }
  },
  "focus": {
    "ring": {
      "$type": "color",
      "$value": "rgba(37, 99, 235, 0.35)",
      "$description": "Hairline focus ring (→ antd controlOutline + focusOutline).",
      "$extensions": {
        "prism.antd": {
          "map": [
            "controlOutline",
            "focusOutline"
          ]
        }
      }
    }
  },
  "state": {
    "success": {
      "$type": "color",
      "$value": "{color.success}",
      "$extensions": {
        "prism.antd": {
          "seed": "colorSuccess"
        }
      }
    },
    "warning": {
      "$type": "color",
      "$value": "{color.warning}",
      "$extensions": {
        "prism.antd": {
          "seed": "colorWarning"
        }
      }
    },
    "error": {
      "$type": "color",
      "$value": "{color.error}",
      "$extensions": {
        "prism.antd": {
          "seed": "colorError"
        }
      }
    },
    "info": {
      "$type": "color",
      "$value": "{color.info}",
      "$extensions": {
        "prism.antd": {
          "seed": "colorInfo"
        }
      }
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "{shape.radius.sm}",
      "$extensions": {
        "prism.antd": {
          "map": "borderRadiusSM"
        }
      }
    },
    "base": {
      "$type": "dimension",
      "$value": "{shape.radius.base}",
      "$description": "Base radius (→ antd borderRadius seed).",
      "$extensions": {
        "prism.antd": {
          "seed": "borderRadius"
        }
      }
    },
    "lg": {
      "$type": "dimension",
      "$value": "{shape.radius.lg}",
      "$extensions": {
        "prism.antd": {
          "map": "borderRadiusLG"
        }
      }
    },
    "outer": {
      "$type": "dimension",
      "$value": "{shape.radius.outer}",
      "$extensions": {
        "prism.antd": {
          "seed": "borderRadius"
        }
      }
    }
  },
  "typography": {
    "family": {
      "ui": {
        "$type": "fontFamily",
        "$value": "{type.family.ui}",
        "$extensions": {
          "prism.antd": {
            "seed": "fontFamily"
          }
        }
      },
      "code": {
        "$type": "fontFamily",
        "$value": "{type.family.mono}",
        "$extensions": {
          "prism.antd": {
            "seed": "fontFamilyCode"
          }
        }
      }
    },
    "size": {
      "$type": "dimension",
      "$value": "{type.size.ui}",
      "$extensions": {
        "prism.antd": {
          "seed": "fontSize"
        }
      }
    },
    "weight": {
      "strong": {
        "$type": "fontWeight",
        "$value": "{type.weight.strong}",
        "$extensions": {
          "prism.antd": {
            "seed": "fontWeightStrong"
          }
        }
      }
    }
  },
  "spacing": {
    "unit": {
      "$type": "dimension",
      "$value": "{space.unit}",
      "$extensions": {
        "prism.antd": {
          "seed": "sizeUnit"
        }
      }
    },
    "step": {
      "$type": "dimension",
      "$value": "{space.step}",
      "$extensions": {
        "prism.antd": {
          "seed": "sizeStep"
        }
      }
    }
  },
  "motion": {
    "timing": {
      "fast": {
        "$type": "duration",
        "$value": "{motion.duration.fast}",
        "$extensions": {
          "prism.antd": {
            "seed": [
              "motionUnit",
              "motionBase"
            ]
          }
        }
      },
      "mid": {
        "$type": "duration",
        "$value": "{motion.duration.mid}",
        "$extensions": {
          "prism.antd": {
            "seed": [
              "motionUnit",
              "motionBase"
            ]
          }
        }
      },
      "slow": {
        "$type": "duration",
        "$value": "{motion.duration.slow}",
        "$description": "The locked 280ms (→ antd motionDurationSlow map token).",
        "$extensions": {
          "prism.antd": {
            "map": "motionDurationSlow"
          }
        }
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": "{motion.curve.standard}",
        "$extensions": {
          "prism.antd": {
            "seed": [
              "motionEaseOut",
              "motionEaseInOut",
              "motionEaseOutQuint",
              "motionEaseOutCirc"
            ]
          }
        }
      },
      "opacity": {
        "$type": "cubicBezier",
        "$value": "{motion.curve.opacity}",
        "$description": "No antd destination — prism-ui CSS only.",
        "$extensions": {
          "prism.antd": {
            "none": true
          }
        }
      }
    }
  },
  "elevation": {
    "floating": {
      "$type": "string",
      "$value": "{elevation.floating.light}",
      "$description": "STRING alias — Dev Mode parity only; cannot bind to a Figma effect.",
      "$extensions": {
        "prism.antd": {
          "map": "boxShadow"
        }
      }
    },
    "none": {
      "$type": "string",
      "$value": "none",
      "$description": "In-plane surfaces never shadow (→ boxShadowSecondary/Tertiary).",
      "$extensions": {
        "prism.antd": {
          "map": [
            "boxShadowSecondary",
            "boxShadowTertiary"
          ]
        }
      }
    }
  }
}
