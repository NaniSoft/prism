{
  "shadow": {
    "$type": "shadow",
    "$description": "Elevation steps. The Three-Step Rule is a property of this source, not an observation about the registry: xs on filled controls, sm on the resting surface, md on the lifted element, and md is the ceiling. Every stack is two named layer kinds in a fixed order. The edge finish comes first: the top rim highlight and the inside hairline, both one-pixel insets whose colours are the semantic elevation roles (rim, inner), because a highlight on glass is a colour decision and colour decisions are mode-scoped. The depth layers come second: a tight contact shadow and a wide soft shade, both black alpha with a real vertical offset and a soft blur. The colours are `var()` references rather than literals so one geometry serves both modes; the stylesheet resolves them per mode. There is no docs-only fourth step: the site is a second consumer of this source. A Component that needs a step between md and a floating panel requests it here.",
    "xs": {
      "$value": [
        {
          "inset": true,
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 1, "unit": "px" },
          "blur": { "value": 0, "unit": "px" },
          "color": "var(--elevation-rim)"
        },
        {
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 1, "unit": "px" },
          "blur": { "value": 2, "unit": "px" },
          "color": "var(--elevation-contact)"
        }
      ]
    },
    "sm": {
      "$value": [
        {
          "inset": true,
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 1, "unit": "px" },
          "blur": { "value": 0, "unit": "px" },
          "color": "var(--elevation-rim)"
        },
        {
          "inset": true,
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 0, "unit": "px" },
          "blur": { "value": 0, "unit": "px" },
          "spread": { "value": 1, "unit": "px" },
          "color": "var(--elevation-inner)"
        },
        {
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 1, "unit": "px" },
          "blur": { "value": 2, "unit": "px" },
          "color": "var(--elevation-contact)"
        },
        {
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 4, "unit": "px" },
          "blur": { "value": 16, "unit": "px" },
          "spread": { "value": -8, "unit": "px" },
          "color": "var(--elevation-shade)"
        }
      ]
    },
    "md": {
      "$value": [
        {
          "inset": true,
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 1, "unit": "px" },
          "blur": { "value": 0, "unit": "px" },
          "color": "var(--elevation-rim)"
        },
        {
          "inset": true,
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 0, "unit": "px" },
          "blur": { "value": 0, "unit": "px" },
          "spread": { "value": 1, "unit": "px" },
          "color": "var(--elevation-inner)"
        },
        {
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 2, "unit": "px" },
          "blur": { "value": 4, "unit": "px" },
          "spread": { "value": -1, "unit": "px" },
          "color": "var(--elevation-contact)"
        },
        {
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 12, "unit": "px" },
          "blur": { "value": 32, "unit": "px" },
          "spread": { "value": -12, "unit": "px" },
          "color": "var(--elevation-shade)"
        }
      ]
    }
  }
}
