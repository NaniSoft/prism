{
  "dimension": {
    "$type": "dimension",
    "$description": "Primitive spacing and sizing values. Use the rem scale; Tailwind's spacing utilities map to these directly.",
    "spacing": {
      "0": { "$value": { "value": 0, "unit": "px" } },
      "0.5": { "$value": { "value": 0.125, "unit": "rem" } },
      "1": { "$value": { "value": 0.25, "unit": "rem" } },
      "1.5": { "$value": { "value": 0.375, "unit": "rem" } },
      "2": { "$value": { "value": 0.5, "unit": "rem" } },
      "2.5": { "$value": { "value": 0.625, "unit": "rem" } },
      "3": { "$value": { "value": 0.75, "unit": "rem" } },
      "3.5": { "$value": { "value": 0.875, "unit": "rem" } },
      "4": { "$value": { "value": 1, "unit": "rem" } },
      "5": { "$value": { "value": 1.25, "unit": "rem" } },
      "6": { "$value": { "value": 1.5, "unit": "rem" } },
      "7": { "$value": { "value": 1.75, "unit": "rem" } },
      "8": { "$value": { "value": 2, "unit": "rem" } },
      "9": { "$value": { "value": 2.25, "unit": "rem" } },
      "10": { "$value": { "value": 2.5, "unit": "rem" } },
      "12": { "$value": { "value": 3, "unit": "rem" } },
      "14": { "$value": { "value": 3.5, "unit": "rem" } },
      "16": { "$value": { "value": 4, "unit": "rem" } },
      "20": { "$value": { "value": 5, "unit": "rem" } },
      "24": { "$value": { "value": 6, "unit": "rem" } }
    }
  },
  "fontFamily": {
    "$type": "fontFamily",
    "$description": "Typeface stacks. The sans stack is a variable font; the mono stack is fixed-width.",
    "sans": {
      "$value": [
        "Inter",
        "ui-sans-serif",
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "Roboto",
        "Helvetica Neue",
        "Arial",
        "sans-serif"
      ]
    },
    "mono": {
      "$value": [
        "ui-monospace",
        "SFMono-Regular",
        "SF Mono",
        "Menlo",
        "Consolas",
        "Liberation Mono",
        "monospace"
      ]
    }
  },
  "fontWeight": {
    "$type": "fontWeight",
    "$description": "Numeric weights matching the Inter variable font axes.",
    "regular": { "$value": 400 },
    "medium": { "$value": 500 },
    "semibold": { "$value": 600 },
    "bold": { "$value": 700 }
  },
  "duration": {
    "$type": "duration",
    "$description": "Motion durations. Pair with the easing tokens below; never hardcode a duration in a component.",
    "instant": { "$value": { "value": 80, "unit": "ms" } },
    "fast": { "$value": { "value": 150, "unit": "ms" } },
    "normal": { "$value": { "value": 250, "unit": "ms" } },
    "slow": { "$value": { "value": 400, "unit": "ms" } }
  },
  "cubicBezier": {
    "$type": "cubicBezier",
    "$description": "Easing curves. `standard` is the default for UI transitions; `emphasized` is for entry/exit and larger movement.",
    "linear": { "$value": [0, 0, 1, 1] },
    "standard": { "$value": [0.2, 0, 0, 1] },
    "emphasized": { "$value": [0.2, 0, 0, 1.05] },
    "exit": { "$value": [0.4, 0, 1, 1] }
  }
}
