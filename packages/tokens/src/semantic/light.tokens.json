{
  "$description": "Light mode. Token names match shadcn/ui's CSS variable contract exactly, so every shadcn block, theme and consumer works against this theme unmodified. Values are aliases into the foundation ramps, never raw hex.",
  "background": { "$value": "{color.neutral.0}", "$description": "Default app background." },
  "foreground": { "$value": "{color.neutral.900}", "$description": "Default text and icon color." },
  "card": { "$value": "{color.neutral.0}", "$description": "Elevated surface." },
  "card-foreground": { "$value": "{color.neutral.900}", "$description": "Content inside a card." },
  "popover": { "$value": "{color.neutral.0}", "$description": "Floating surface." },
  "popover-foreground": { "$value": "{color.neutral.900}", "$description": "Content inside a popover." },
  "primary": { "$value": "{color.neutral.900}", "$description": "High-emphasis actions and brand surfaces." },
  "primary-foreground": { "$value": "{color.neutral.0}", "$description": "Text on a primary surface." },
  "secondary": { "$value": "{color.neutral.100}", "$description": "Lower-emphasis filled actions." },
  "secondary-foreground": { "$value": "{color.neutral.900}", "$description": "Text on a secondary surface." },
  "muted": { "$value": "{color.neutral.100}", "$description": "Subtle surfaces." },
  "muted-foreground": { "$value": "{color.neutral.500}", "$description": "Helper and placeholder text." },
  "accent": { "$value": "{color.neutral.100}", "$description": "Hover, focus and active surfaces." },
  "accent-foreground": { "$value": "{color.neutral.900}", "$description": "Text on an accent surface." },
  "destructive": { "$value": "{color.red.600}", "$description": "Destructive actions and error emphasis." },
  "destructive-foreground": { "$value": "{color.neutral.0}", "$description": "Text on a destructive surface." },
  "success": { "$value": "{color.green.700}", "$description": "Positive confirmation." },
  "success-foreground": { "$value": "{color.neutral.0}", "$description": "Text on a success surface." },
  "warning": { "$value": "{color.amber.500}", "$description": "Cautionary emphasis." },
  "warning-foreground": { "$value": "{color.neutral.950}", "$description": "Text on a warning surface." },
  "border": { "$value": "{color.neutral.200}", "$description": "Borders and separators." },
  "input": { "$value": "{color.neutral.200}", "$description": "Form control borders." },
  "ring": { "$value": "{color.neutral.500}", "$description": "Focus rings. Pinned to a step that clears 3:1 against the surface." },
  "chart-1": { "$value": "{color.brand.500}" },
  "chart-2": { "$value": "{color.teal.500}" },
  "chart-3": { "$value": "{color.amber.500}" },
  "chart-4": { "$value": "{color.neutral.500}" },
  "chart-5": { "$value": "{color.red.500}" },
  "sidebar": { "$value": "{color.neutral.50}", "$description": "Sidebar surface." },
  "sidebar-foreground": { "$value": "{color.neutral.900}", "$description": "Sidebar text." },
  "sidebar-primary": { "$value": "{color.neutral.900}", "$description": "Active item in the sidebar." },
  "sidebar-primary-foreground": { "$value": "{color.neutral.0}", "$description": "Text on a sidebar primary surface." },
  "sidebar-accent": { "$value": "{color.neutral.100}", "$description": "Sidebar hover and selected state." },
  "sidebar-accent-foreground": { "$value": "{color.neutral.900}", "$description": "Text on a sidebar accent surface." },
  "sidebar-border": { "$value": "{color.neutral.200}", "$description": "Sidebar borders." },
  "sidebar-ring": { "$value": "{color.neutral.400}", "$description": "Sidebar focus rings." }
}
