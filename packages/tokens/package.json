{
  "name": "@nanisoft/prism-tokens",
  "version": "0.5.0",
  "type": "module",
  "description": "Design tokens authored in DTCG, compiled to shadcn-compatible CSS.",
  "license": "MIT",
  "author": "NaniSoft",
  "homepage": "https://prism.nanisoft.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/NaniSoft/prism.git",
    "directory": "packages/tokens"
  },
  "exports": {
    ".": "./dist/index.js",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build/build.mjs && pnpm check",
    "watch": "node build/build.mjs --watch",
    "check": "node scripts/check-contrast.mjs",
    "gen": "node scripts/gen-pastel.mjs"
  },
  "devDependencies": {
    "style-dictionary": "^4.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.7.0"
  }
}
