    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "author": "NaniSoft",
  "homepage": "https://prism.nanisoft.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NaniSoft/prism.git",
    "directory": "packages/tokens"
