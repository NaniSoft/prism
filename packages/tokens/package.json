{
  "name": "@nanisoft/prism-tokens",
  "version": "0.5.0",
  "type": "module",
  "description": "Design tokens authored in DTCG, compiled to shadcn-compatible CSS.",
  "license": "MIT",
  "author": "NaniSoft",
  "homepage": "https://prism.nanisoft.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NaniSoft/prism.git",
    "directory": "packages/tokens"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build/build.mjs && pnpm check",
    "watch": "node build/build.mjs --watch",
    "check": "node scripts/check-contrast.mjs && node scripts/check-emitted-contract.mjs && node scripts/check-determinism.mjs",
    "pretest": "node build/build.mjs",
    "test": "vitest run",
    "gen": "node scripts/gen-pastel.mjs",
    "prepack": "node ../../scripts/stage-package-files.mjs",
    "prepublishOnly": "publint"
  },
  "devDependencies": {
    "style-dictionary": "^4.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
