{
  "name": "@nanisoft/prism-ui",
  "version": "0.5.0",
  "type": "module",
  "description": "Component + block source of truth, published as a shadcn registry.",
  "license": "MIT",
  "author": "NaniSoft",
  "homepage": "https://prism.nanisoft.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/NaniSoft/prism.git",
    "directory": "packages/ui"
  },
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./registry.json": "./registry.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "registry.json",
    "public/r",
    "components.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "sync": "node scripts/sync-registry.mjs",
    "validate": "node scripts/validate-registry.mjs",
    "build": "pnpm sync && pnpm validate && shadcn build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "shadcn": "^3.6.0",
    "typescript": "^5.7.0"
  }
}
